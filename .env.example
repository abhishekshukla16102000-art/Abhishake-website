# OpenRouter. The default router selects only currently available free models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Zoho Mail India OAuth server-based application
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Private admin access. Generate independent random values (32+ characters each).
OUTREACH_ADMIN_TOKEN=
OUTREACH_SESSION_SECRET=
